{
  "name": "pi-latest-models",
  "version": "0.1.0",
  "description": "Show only the newest model of each family (Sonnet, Opus, GPT-…, Gemini Flash, …) in pi's /model list.",
  "type": "module",
  "license": "MIT",
  "author": "hwisu",
  "homepage": "https://github.com/hwisu/pi-latest-models#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hwisu/pi-latest-models.git"
  },
  "bugs": {
    "url": "https://github.com/hwisu/pi-latest-models/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "models",
    "model-selector"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
